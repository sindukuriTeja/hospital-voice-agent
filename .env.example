# ---- Copy this file to .env and fill in your values ----

# ElevenLabs (you already have this)
ELEVENLABS_API_KEY=your_elev
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Exotel (from dashboard -> API Credentials)
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Leave default unless Exotel gives you a different API host
EXOTEL_API_BASE=https://api.in.exotel.com

# Ollama (defaults are fine if Ollama runs locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Speech-to-text model (tiny.en is fastest, base.en is more accurate)
WHISPER_MODEL=base.en

# Optional tuning
PORT=8080
SPEECH_RMS_THRESHOLD=300
END_SILENCE_MS=700
GREETING=Hello, welcome to Sunrise City Hospital. How can I help you today?